{
  "name": "emma-router",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('node:fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start-api": "node server/index.js",
    "alchemy:smoke": "node --env-file=.env scripts/alchemy-smoke.mjs",
    "listen:trades": "node --env-file=.env scripts/listen-trades.mjs",
    "seed:feed": "node --env-file=.env scripts/seed-active-feed.mjs"
  },
  "dependencies": {
    "@mantine/charts": "^8.3.7",
    "@mantine/core": "^8.3.7",
    "@mantine/hooks": "^8.3.7",
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tabler/icons-react": "^3.9.0",
    "@tanstack/react-query": "^5.51.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.24.1",
    "recharts": "^3.4.1",
    "viem": "^2.21.0",
    "wagmi": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "react-is": "^19.2.7",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
